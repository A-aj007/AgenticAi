PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security Keys
JWT_SECRET=super_secret_jwt_key_agentflow_ai_2026_secure
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=32_bytes_hex_secret_key_agentflow_2026_prod!

# Database & Redis (Optional - In-Memory fallbacks activate automatically if absent)
MONGODB_URI=mongodb://localhost:27017/agentflow_ai
REDIS_URL=redis://localhost:6379

# AI Providers (Optional - Deterministic Rule Generator will execute if keys are omitted)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OAuth & Integrations Configuration (Optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5001/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5001/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5001/api/integrations/oauth/discord/callback

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
