{
  "name": "agentflow-ai-workspace",
  "version": "1.0.0",
  "description": "Agentflow_AI - Agentic AI Automation Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm --prefix server start\" \"npm --prefix client start\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "db:inspect": "npm --prefix server run db:inspect"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
